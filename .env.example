# ============================================
# UltraThinking Monorepo - Environment Variables
# ============================================
# Copy this file to .env and configure your values
# NEVER commit .env to version control
# ============================================

# ============================================
# Global Configuration
# ============================================

NODE_ENV=development
LOG_LEVEL=debug
ENVIRONMENT=development

# ============================================
# Database Configuration - PostgreSQL
# ============================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ultrathinking
POSTGRES_PASSWORD=ultrathinking_dev_password
POSTGRES_DB=ultrathinking_dev

# ============================================
# Redis Configuration
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# ============================================
# MongoDB Configuration
# ============================================

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=mongo_dev_password

# ============================================
# Web Service Ports
# ============================================

WEB_CLISONIX_MAIN_PORT=8000
WEB_CLISONIX_BLOG_PORT=8001
WEB_CLISONIX_NEWS_PORT=8002
WEB_ULTRATHINKING_PORT=8003
WEB_ULTRAWEBTHINKING_PORT=8004
WEB_REACT_STARTER_PORT=8005

# ============================================
# Application Ports
# ============================================

APP_STARBOOKING_PORT=3000
APP_HARMONIC_PORT=3001
APP_CWY_PORT=3002
APP_ABA_PORT=3003

# ============================================
# Backend Service Ports
# ============================================

SERVICE_CLISONIX_CLOUD_PORT=5000
SERVICE_CLISONIC_CLOUD_PORT=5001
SERVICE_KLOUD_PORT=6000

# ============================================
# API Gateway
# ============================================

API_GATEWAY_PORT=4000
API_GATEWAY_HOST=localhost

# ============================================
# Authentication & Security
# ============================================

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Session
SESSION_SECRET=your_session_secret_change_this_in_production

# Encryption
ENCRYPTION_KEY=your_encryption_key_32_chars_minimum

# ============================================
# CORS Configuration
# ============================================

CORS_ORIGIN=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true

# ============================================
# External APIs
# ============================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# ============================================
# Cloud Provider Configuration
# ============================================

# Azure
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1

# ============================================
# Email Configuration
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@ultrathinking.com

# ============================================
# Monitoring & Observability
# ============================================

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Grafana
GRAFANA_PORT=3100
GRAFANA_PASSWORD=admin_change_this_in_production

# Loki
LOKI_PORT=3101
LOKI_RETENTION=168h

# Jaeger
JAEGER_PORT=16686
JAEGER_COLLECTOR_PORT=14268

# Node Exporter
NODE_EXPORTER_PORT=9100

# cAdvisor
CADVISOR_PORT=8080

# ============================================
# Feature Flags
# ============================================

ENABLE_MONITORING=false
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_LOGGING=true

# ============================================
# Development Tools
# ============================================

# Hot reload
HOT_RELOAD=true

# Debug
DEBUG=true
VERBOSE_LOGGING=true

# ============================================
# Testing
# ============================================

TEST_DATABASE_URL=postgresql://ultrathinking:ultrathinking_dev_password@localhost:5432/ultrathinking_test
TEST_REDIS_URL=redis://:redis_dev_password@localhost:6379/15
